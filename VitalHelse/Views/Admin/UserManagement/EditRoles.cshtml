@model VitalHelse.Models.EditUserRolesViewModel

@{
    ViewData["Title"] = "Rediger Roller";
    Layout = "_AdminLayout";

}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">Rediger Roller</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-user-circle fa-5x text-secondary"></i>
                        <h5 class="mt-3">@Model.Email</h5>
                    </div>

                    <form asp-controller="UserManagement" asp-action="UpdateRoles" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Email" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Velg roller:</label>
                            @for (int i = 0; i < Model.Roles.Count; i++)
                            {
                                <div class="form-check">
                                    <input type="hidden" asp-for="Roles[i].RoleName" />
                                    <input class="form-check-input" 
                                           type="checkbox" 
                                           asp-for="Roles[i].IsSelected" 
                                           id="role_@i" />
                                    <label class="form-check-label" for="role_@i">
                                        @Model.Roles[i].RoleName
                                    </label>
                                </div>
                            }
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lagre
                            </button>
                            <a asp-controller="UserManagement" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Avbryt
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>