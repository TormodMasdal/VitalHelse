@model List<VitalHelse.Models.UserRoleViewModel>

@{
ViewData["Title"] = "Administrer Brukere";
Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-5 pb-3">
        <h2>Administrer Brukere & Roller</h2>

        <div class="d-flex gap-3">
            <a asp-action="AddUser" class="employee-add-button">
                <i class="fas fa-user-plus"></i> Legg Til Bruker
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="employee-back-button">
                <i class="fas fa-arrow-left"></i> Tilbake
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    }

    @if (Model != null && Model.Any())
    {
    <div class="product-grid">
        @foreach (var user in Model)
        {
        <div class="product-card">
            <div class="admin-product-actions">
                <a asp-action="EditRoles" asp-route-id="@user.UserId" class="employee-edit-button">
                    <i class="fas fa-edit"></i> Rediger
                </a>
            </div>

            <div class="text-center mb-3">
                <i class="fas fa-user-circle fa-5x text-secondary"></i>
            </div>

            <h5 class="text-center">@user.Email</h5>

            <div class="text-center mt-3">
                @if (user.CurrentRoles.Any())
                {
                @foreach (var role in user.CurrentRoles)
                {
                <span class="badge bg-primary me-1 mb-1">@role</span>
                }
                }
                else
                {
                <span class="badge bg-secondary">Ingen roller</span>
                }
            </div>

            <div class="mt-3 text-center">
                <small class="text-muted">Bruker ID: @user.UserId.Substring(0, 8)...</small>
            </div>
        </div>
        }
    </div>
    }
    else
    {
    <p class="text-muted text-center mt-4">Ingen brukere funnet.</p>
    }
</div>

<style>
    .admin-product-actions {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 10;
    }
    
    .product-grid {
        margin-top: 3rem;
    }
    
    .employee-add-button,
    .employee-back-button {
        display: inline-block;
        padding: 0.625rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        border-radius: 0.375rem;
        transition: all 0.2s ease;
        white-space: nowrap;
        border: none;
        cursor: pointer;
    }

    .employee-add-button {
        background-color: #C7A47A;
        color: white;
    }

    .employee-add-button:hover {
        background-color: #b89563;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(199, 164, 122, 0.3);
    }

    .employee-back-button {
        background-color: #6c757d;
        color: white;
    }

    .employee-back-button:hover {
        background-color: #5a6268;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(108, 117, 125, 0.3);
    }

    /* Edit button on cards */
    .employee-edit-button {
        background-color: #C7A47A;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        text-decoration: none;
        font-size: 0.875rem;
        transition: all 0.2s ease;
        display: inline-block;
    }

    .employee-edit-button:hover {
        background-color: #b89563;
        color: white;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(199, 164, 122, 0.3);
    }

    /* Ensure gap works */
    .d-flex.gap-3 > * + * {
        margin-left: 1rem;
    }
</style>