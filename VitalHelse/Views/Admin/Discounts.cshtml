@using System.Globalization
@model VitalHelse.Models.DiscountViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kampanjer";
}

<section class="discounts-page">

    <!-- HEADER -->
    <header class="discounts-header">
        <h2 class="discounts-title">Rabatter & Kampanjer</h2>
        <p class="discounts-subtitle">
            Administrer rabatter i sanntid, filtrer etter kategori og lagre samlet.
        </p>
    </header>

    <!-- NAV -->
    <nav class="discounts-nav">
        <button class="discounts-tab active" data-target="section-rates">🎛 Endre rabattsatser</button>
        <button class="discounts-tab" data-target="section-campaigns">⚙️ Kampanjestyring</button>
        <button class="discounts-tab" data-target="section-auto">🤖 Automatiske kampanjer</button>
    </nav>

    <!-- ============================= -->
    <!-- SECTION: RABATTSTYRING       -->
    <!-- ============================= -->
    <section id="section-rates" class="discounts-section active">

        <!-- SAVE BAR -->
        <div class="discounts-topheader">
            <button id="saveAllDiscountsBtn" class="discount-savebtn">💾 Lagre endringer</button>
            <span class="discount-hint">Endringer lagres for kategori- og produktrabatter.</span>
        </div>

        <!-- 2-COLUMN LAYOUT -->
        <div class="discounts-layout">

            <!-- SIDEBAR -->
            <aside class="discounts-sidebar">
                @await Html.PartialAsync("_DiscountFilterSidebar",
                    new DiscountFilterViewModel {
                        Categories = Model.Categories,
                        SelectedCategoryIds = Model.SelectedCategoryIds
                    })
            </aside>

            <!-- PRODUCT LIST -->
            <div class="discounts-listarea">

                <div class="discount-infoline">
                    Viser @Model.Products.Count() av @Model.TotalProducts produkter
                </div>

                <table class="listview__table">
                    <thead>
                    <tr>
                        <th>Produkt</th>
                        <th>Kategori</th>
                        <th>Nåv. kat. rabatt</th>
                        <th>Ny kat. rabatt</th>
                        <th>Nåv. prod. rabatt</th>
                        <th>Ny prod. rabatt</th>
                        <th>Originalpris</th>
                        <th>Ny pris</th>
                    </tr>
                    </thead>

                    <tbody>
                    @foreach (var p in Model.Products)
                    {
                        var cat = p.ProductCategories.FirstOrDefault()?.Category;
                        var catId = cat?.CategoryId;
                        var catName = cat?.CategoryName ?? "—";

                        var catDisc = Model.Discounts.FirstOrDefault(d => d.IsCategoryDiscount && d.CategoryId == catId);
                        var prodDisc = Model.Discounts.FirstOrDefault(d => !d.IsCategoryDiscount && d.ProductId == p.ProductId);

                        var catRate = catDisc?.DiscountRate ?? 0;
                        var prodRate = prodDisc?.DiscountRate ?? 0;
                        var effRate = prodRate > 0 ? prodRate : catRate;
                        var newPrice = p.ProductPriceInVAT * (1 - effRate / 100.0);

                        <tr class="listview__row"
                            data-product-id="@p.ProductId"
                            data-category-id="@(catId?.ToString() ?? "")"
                            data-base-price="@p.ProductPriceInVAT.ToString("0.00", CultureInfo.InvariantCulture)"
                            data-category-rate="@catRate"
                            data-product-rate="@prodRate">

                            <td>@p.ProductName</td>
                            <td>@catName</td>

                            <td>@catRate.ToString("0.0") %</td>

                            <td>
                                @if (catId.HasValue)
                                {
                                    <input type="number"
                                           class="discount-input js-category-rate"
                                           data-category-id="@catId"
                                           value="@catRate"
                                           min="0" max="100" step="0.5" />
                                }
                                else { <span>—</span> }
                            </td>

                            <td>@prodRate.ToString("0.0") %</td>

                            <td>
                                <input type="number"
                                       class="discount-input js-product-rate"
                                       value="@prodRate"
                                       min="0" max="100" step="0.5" />
                            </td>

                            <td>@p.ProductPriceInVAT.ToString("0.00") kr</td>
                            <td><span class="js-new-price">@newPrice.ToString("0.00") kr</span></td>
                        </tr>
                    }
                    </tbody>
                </table>

            </div>
        </div>
    </section>

</section>

@section Scripts {
    <script src="~/js/Admin/discount.js"></script>
}
