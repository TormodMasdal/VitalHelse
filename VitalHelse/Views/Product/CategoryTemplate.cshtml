@using VitalHelse.Helpers

@model VitalHelse.Models.CategoryViewModel
@{
    ViewBag.Title = Model.CurrentCategory.CategoryName;
    Layout = "_Layout";
}

<section class="category-header text-center mb-5">
    <h1 class="category-title">@Model.CurrentCategory.CategoryName.ToUpper()</h1>
</section>


<div class="category-page">

    @{
        var currentPath = Context.Request.Path.Value?.Replace("/produkt/", "").Trim('/') ?? "";
    }

    @if (Model.SubCategories.Any())
    {
        <div class="subcategory-bar text-center mb-4">
            @foreach (var sub in Model.SubCategories)
            {
                var newPath = $"{currentPath}/{sub.CategoryName}".Trim('/');

                <a class="subcategory-link"
                   href="/produkt/@newPath">
                    @sub.CategoryName.ToUpper()
                </a>
            }
        </div>
    }


    @if (Model.Products.Any())
    {
        <div class="product-grid">
            @foreach (var product in Model.Products)
            {
                <div class="product-card">
                    <img src="@(product.ProductPictures.FirstOrDefault()?.PicturePath ?? "/images/products/default.png")"
                         alt="@product.ProductName" class="product-img" />
                    <h5>@product.ProductName</h5>
                    <p class="desc">@product.ProductDescription</p>
                    <p class="price">@product.ProductPrice.ToString("0.00") kr</p>
                    <a class="learn-more" href="@SlugHelper.BuildProductPath(product)">Se produkt</a>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Ingen produkter funnet i denne kategorien.</p>
    }
</div>