@model VitalHelse.Models.CategoryViewModel
@{
    ViewBag.Title = Model.CurrentCategory.CategoryName;
    Layout = "_Layout";
}

<div class="category-page">

    <h2 class="category-title">
        @(char.ToUpper(Model.CurrentCategory.CategoryName[0]) + Model.CurrentCategory.CategoryName.Substring(1))
    </h2>

    @if (Model.SubCategories.Any())
    {
        <div class="subcategory-bar">
            @foreach (var sub in Model.SubCategories)
            {
                <a class="subcategory-link" href="/produkt/@sub.CategoryName">
                    @(char.ToUpper(sub.CategoryName[0]) + sub.CategoryName.Substring(1))
                </a>
            }
        </div>
    }

    @if (Model.Products.Any())
    {
        <div class="product-grid">
            @foreach (var product in Model.Products)
            {
                <div class="product-card">
                    <img src="@(product.ProductPictures.FirstOrDefault()?.PicturePath ?? "/images/products/default.png")"
                         alt="@product.ProductName" class="product-img" />
                    <h5>@product.ProductName</h5>
                    <p class="desc">@product.ProductDescription</p>
                    <p class="price">@product.ProductPrice.ToString("0.00") kr</p>
                    <a class="learn-more" href="@Url.Action("Details", "Product", new { id = product.ProductId })">Se produkt</a>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Ingen produkter funnet i denne kategorien.</p>
    }
</div>