@model VitalHelse.Models.CategoryViewModel
@using VitalHelse.Helpers

@{
    ViewData["Title"] = Model?.CurrentCategory?.CategoryName ?? "Kategori";
    Layout = "_Layout";
}
@* 🔹 Popup when product is added to cart *@
<div id="cart-popup">
    <h4 style="padding:2rem ">Produktet er lagt til i handlekurven!</h4>
    <div style="margin-bottom: 1rem">
        <button id="continue-shopping" class="btn-submit" style="margin: 1rem">Fortsett å handle</button>
        <button id="go-to-cart" class="btn-submit" style="margin: 1rem">Gå til handlekurv</button>
    </div>
</div>

<div class="category-page">
    <section class="category-header text-center">
        <h1 class="category-title">@Model?.CurrentCategory?.CategoryName?.ToUpper()</h1>
    </section>

    @{
        var currentPath = Context.Request.Path.Value?.Replace("/produkt/", "").Trim('/') ?? "";
    }

    @* 🔹 Underkategorier *@
    @if (Model.SubCategories != null && Model.SubCategories.Any())
    {
        <div class="subcategory-bar text-center mb-4">
            @foreach (var sub in Model.SubCategories)
            {
                var newPath = $"{currentPath}/{SlugHelper.ToUrlFriendly(sub.CategoryName)}".Trim('/');

                <a class="subcategory-link" href="/produkt/@newPath">
                    @sub.CategoryName.ToUpper()
                </a>
            }
        </div>
    }

    @* 🔹 Produktgrid (hentes fra partial view) *@
    @await Html.PartialAsync("_ProductGrid",
        Model?.Products ?? Enumerable.Empty<VitalHelse.Models.Product>(),
        new ViewDataDictionary(ViewData) {
            { "IsAuthenticated", User.Identity?.IsAuthenticated ?? false }
        })

</div>