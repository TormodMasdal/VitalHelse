@model VitalHelse.Models.CategoryViewModel
@{
    ViewBag.Title = Model.CurrentCategory.CategoryName;
    Layout = "_Layout";
}

<h2 class="mt-3">@Model.CurrentCategory.CategoryName</h2>

@if (Model.SubCategories.Any())
{
    <div class="mb-3">
        <strong>Underkategorier:</strong>
        @foreach (var sub in Model.SubCategories)
        {
            <a class="btn btn-sm btn-outline-primary me-1 mb-1"
               href="@Url.Action("Category", "Product", new { 
                   category = Model.ParentCategoryName ?? Model.CurrentCategory.CategoryName,
                   subcategory = Model.CurrentCategory.CategoryName,
                   subsubcategory = sub.CategoryName 
               })">
                @sub.CategoryName
            </a>
        }
    </div>
}

@if (Model.Products.Any())
{
    <div class="row">
        @foreach (var product in Model.Products)
        {
            <div class="col-sm-6 col-md-4 col-lg-3 mb-3">
                <div class="card h-100">
                    <img class="card-img-top" 
                         src="@(product.ProductPictures.FirstOrDefault()?.PicturePath ?? "/images/products/default.png")" 
                         alt="@product.ProductName" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.ProductName</h5>
                        @if (!string.IsNullOrEmpty(product.ProductDescription))
                        {
                            <p class="card-text">@product.ProductDescription</p>
                        }
                        <p class="card-text fw-bold">@product.ProductPrice.ToString("0.00") kr</p>
                        @if (product.ProductTags.Any())
                        {
                            <p class="mb-1">
                                @foreach (var tag in product.ProductTags)
                                {
                                    <span class="badge bg-secondary me-1">@tag.Tag.Tags</span>
                                }
                            </p>
                        }
                        <a class="btn btn-primary mt-auto" 
                           href="@Url.Action("Details", "Product", new { id = product.ProductId })">
                            Se produkt
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">Ingen produkter funnet i denne kategorien.</p>
}
