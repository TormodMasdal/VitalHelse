@model VitalHelse.Models.CategoryViewModel

@if (Model.CurrentCategory.ParentCategory != null)
{
    <nav class="mb-2">
        <a href="@Url.Action("Category", "Product", new { categoryPath = Model.CurrentCategory.ParentCategory.CategoryName })">
            @Model.CurrentCategory.ParentCategory.CategoryName
        </a>
        /
        <span>@Model.CurrentCategory.CategoryName</span>
    </nav>
}

<h2 class="mt-3">
    @(char.ToUpper(Model.CurrentCategory.CategoryName[0]) + Model.CurrentCategory.CategoryName.Substring(1))
</h2>


@if (Model.SubCategories.Any())
{
    <div class="mb-3 d-flex flex-wrap">
        <strong class="me-2">Underkategorier:</strong>
        @foreach (var sub in Model.SubCategories)
        {
            <a class="btn btn-sm btn-outline-primary me-1 mb-1"
               href="/produkt/@Model.CurrentCategory.CategoryName/@sub.CategoryName">
                @(char.ToUpper(sub.CategoryName[0]) + sub.CategoryName.Substring(1))
            </a>

        }

    </div>
}

@{
    ViewBag.Title = Model.CurrentCategory.CategoryName;
    Layout = "_Layout";
}


@if (Model.Products.Any())
{
    <div class="row">
        @foreach (var product in Model.Products)
        {
            <div class="col-sm-6 col-md-4 col-lg-3 mb-3">
                <div class="card h-100">
                    <img class="card-img-top"
                         src="@(product.ProductPictures.FirstOrDefault()?.PicturePath ?? "/images/products/default.png")"
                         alt="@product.ProductName" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.ProductName</h5>
                        <p class="card-text fw-bold">@product.ProductPrice.ToString("0.00") kr</p>
                        <a class="btn btn-primary mt-auto"
                           href="@Url.Action("Details", "Product", new { id = product.ProductId })">
                            Se produkt
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
