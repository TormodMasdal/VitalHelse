@model IEnumerable<VitalHelse.Models.Product>

<!-- currently a temp page for search results
my idea is when a user clicks a product the user gets redirected
to the SEO product page, e.g instead of /search/search-query?whatever
it gets taken to "/vitaminer/c-vitaminer/berits-c-vitamin" -->
@{
    ViewData["Title"] = "Search Results";
    var searchQuery = ViewData["SearchQuery"] as string;
}

<div class="container mt-4">
    <h2>Search Results for "@searchQuery"</h2>
    <p class="text-muted">Found @Model.Count() product(s)</p>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        @if (product.ProductPictures != null && product.ProductPictures.Any())
                        {
                            <img src="@product.ProductPictures.First().ProductPictureId" class="card-img-top" alt="@product.ProductName">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                No Image
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text">@product.ProductDescription</p>
                            <p class="card-text"><strong>Kr @product.ProductPrice.ToString("F2")</strong></p>
                            <a href="#" class="btn btn-primary">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No products found matching your search query. Try different keywords.
        </div>
    }
</div>