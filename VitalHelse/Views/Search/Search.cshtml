@using VitalHelse.Helpers
@model IEnumerable<VitalHelse.Models.Product>

<!-- currently a temp page for search results
my idea is when a user clicks a product the user gets redirected
to the SEO product page, e.g instead of /search/search-query?whatever
it gets taken to "/vitaminer/c-vitaminer/berits-c-vitamin" -->

@{
    ViewData["Title"] = "Søk";
    var searchQuery = ViewData["SearchQuery"] as string ?? "";
}

<section class="category-header text-center mb-5">
    <h1 class="category-title">
        @(Model.Any()
            ? $"{Model.Count()} produkter funnet for \"{searchQuery}\""
            : $"Ingen produkter funnet for \"{searchQuery}\"")
    </h1>
</section>

@await Html.PartialAsync("_ProductGrid", Model)
