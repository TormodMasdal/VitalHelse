@using VitalHelse.Models.Enums
@model VitalHelse.Models.Address
@{
    ViewData["Title"] = "Leveringsadresse";
    Layout = "_CheckoutLayout";
    ViewData["CheckoutStep"] = CheckoutStep.Address;

    // Gets the addresslist from the controller
    var addresses = ViewBag.Addresses as List<VitalHelse.Models.Address> ?? new();
    // Check if user already has any addresses (true/false)
    var hasAddresses = addresses.Count > 0;

    // Check if the controller sendt a selected AddressId
    int? selectedId = ViewBag.SelectedAddressId as int?;
    // If there are none checked addresses but user has addressses, select the first in the list
    if (!selectedId.HasValue && hasAddresses)
    {
        selectedId = addresses[0].AddressId;
    }
}

<div class="container mt-4">
    @if (hasAddresses)
    {
        <form asp-action="SelectAddress" asp-controller="ShoppingCart" method="post" class="mb-4">
            @Html.AntiForgeryToken()

            <ul class="list-group mb-3">
                @foreach (var a in addresses)
                {
                    <li class="list-group-item d-flex align-items-center">
                        <input class="form-check-input me-3"
                               type="radio"
                               id="addr-@a.AddressId"
                               name="selectedAddressId"
                               value="@a.AddressId"
                               @(selectedId.HasValue && selectedId.Value == a.AddressId ? "checked" : null) />

                        <label class="mb-0" for="addr-@a.AddressId">
                            <div class="fw-semibold">@a.Street</div>
                            <div class="text-muted">@a.PostalCode @a.City</div>
                        </label>
                    </li>
                }
            </ul>

            <div class="d-flex gap-2">
                
                <button class="btn btn-outline-secondary" type="button"
                        data-bs-toggle="collapse" data-bs-target="#addForm"
                        aria-expanded="false" aria-controls="addForm">
                    Legg til ny adresse
                </button>
            </div>
        </form>
        
        <div class="collapse mt-3" id="addForm">
            <div class="card card-body">
                <h6 class="mb-3">Ny adresse</h6>
                
                <div asp-validation-summary="All" class="text-danger mb-2"></div>

                @Html.Partial("_AddAddressForm", Model) 
            </div>
        </div>
    }
    else
    {
        <div class="add-new-address-alert">
            <h6>Du har ingen lagrede adresser. Legg til en ny adresse for å fortsette. <a href="#">Legg til ny adresse</a></h6>
        </div>
        
        <div asp-validation-summary="All" class="text-danger mb-2"></div>

        <div class="card card-body">
            @Html.Partial("_AddAddressForm", Model) 
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>Summary();</script>
}
