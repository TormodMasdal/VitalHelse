@model List<CartProduct>

<h2>Handlekurv</h2>

@if (Model == null || !Model.Any())
{
    <p>Handlekurven er tom.</p>
}
else
{
    <table>
        <thead>
        <tr>
            <th>Produkt</th>
            <th>Antall</th>
            <th>Total Pris</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><button onclick="removItemShoppingCart(@item.ProductId)">-</button>
                    @item.Product.ProductName</td>
                <td><button onclick="DecreaseQuantity(@item.ProductId)">-</button> @item.Quantity <button onclick="AddQuantity(@item.ProductId)">+</button></td>
                <td>@(item.Product.ProductCampaignPrice * item.Quantity ?? item.Product.ProductPrice * item.Quantity) kr</td>
            </tr>
        }
        </tbody>
    </table>
}
@section Scripts {
    <script src="~/js/ShoppingCart.js"></script>
}


