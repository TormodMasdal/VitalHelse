@model List<CartProduct>

<h2>Handlekurv</h2>

<div id="error-box" style="color:red; font-weight:bold; margin-top:10px;"></div>



@if (Model == null || !Model.Any())
{
    <p>Handlekurven er tom.</p>
}
else
{
    @Html.AntiForgeryToken()

    <table>
        <thead>
        <tr>
            <th>Produkt</th>
            <th>Antall</th>
            <th>Total Pris</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr id="row-@item.ProductId">
                <td><button onclick="removItemShoppingCart(@item.ProductId)">-</button>
                    @item.Product.ProductName</td>
            <td><button onclick="DecreaseQuantity(@item.ProductId, @(item.Product.ProductCampaignPrice ?? item.Product.ProductPriceInVAT))">-</button>
                <span id="quantity-@item.ProductId">@item.Quantity</span> 
                <button onclick="AddQuantity(@item.ProductId, @(item.Product.ProductCampaignPrice ?? item.Product.ProductPriceInVAT))">+</button>
            </td>
            <td>
                    <button onclick="AddQuantity(@item.ProductId, @(item.Product.ProductCampaignPrice ?? item.Product.ProductPriceInVAT))">+</button>
                </td>
                <td id="total-@item.ProductId">
                    @(item.Product.ProductCampaignPrice * item.Quantity ?? item.Product.ProductPriceInVAT * item.Quantity) kr
                </td>
            </tr>
        }
        </tbody>
    </table>
    
    <form action="/api/checkout/create-session" method="POST">
        <button type="submit" id="submit">Buy</button>
    </form>

}
@section Scripts {
    <script src="~/js/components/shoppingCart.js"></script>
}


