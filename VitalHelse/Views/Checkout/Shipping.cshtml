@using VitalHelse.Models.Enums
@model VitalHelse.Models.UserAddress
@{
    ViewData["Title"] = "Leveringsadresse";
    Layout = "_CheckoutLayout";
}

<div class="list-group-item py-4 px-6">
    <div class="card">
        <div class="card-body">
            Posten/PostNord
        </div>
    </div>
</div>

<form action="/checkout.html" method="GET">
    <input type="hidden" name="product" value="serum" />
    <input type="number" name="quantity" value="2" min="1" />
    <button type="submit">Kjøp nå</button>
</form>