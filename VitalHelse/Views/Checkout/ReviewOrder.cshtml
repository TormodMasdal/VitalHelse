@using VitalHelse.Models.Enums
@model VitalHelse.Models.ReviewOrderViewModel
@{
    ViewData["Title"] = "Leveringsadresse";
    Layout = "_CheckoutLayout";
}

<h2 class="text-start">Se gjennom bestilling</h2>

<section class="mb-4">
    <h4 class="text-start">Produkter</h4>
    <ul class="list-group">
        @foreach (var item in Model.CartProducts)
        {
            <li class="list-group-item py-4 px-6">
                <div  class="row align-items-center gy-3">

                    <!-- Product image -->
                    <div class="col-3 col-sm-2">
                        <img class="w-75" src="@(item.Product.ProductPictures.FirstOrDefault()?.PicturePath ?? "/images/products/default.png")"
                             alt="@item.Product.ProductName"/>
                    </div>

                    <!-- Product name and stock -->
                    <div class="col">
                        <h6 class="mb-2">@item.Product.ProductName</h6>
                        <div>Antall: @item.Quantity</div>
                    </div>
                    
                    <!-- Price -->
                    <div class="col-4 col-sm-3 col-lg-2 text-end">
                        <div id="total-@item.ProductId" class="fw-semibold">@(item.Product.ProductCampaignPrice * item.Quantity ?? item.Product.ProductPriceInVAT * item.Quantity) kr</div>
                    </div>

                </div>
            </li>
        }
    </ul>

</section>

<section>
    <h4 class="text-start">Leveringsadresse</h4>
    <ul class="list-group">
        <li class="list-group-item">
            <div class="row">
                <div class="col">
                    <div class="row align-items-center">

                        <div class="col-6">
                            <label class="d-flex text-start py-2">
                                <div class="flex-grow-1">
                                    <h6>@Model.UserAddress.FirstName @Model.UserAddress.LastName</h6>
                                    <h6>@Model.UserAddress.Street</h6>
                                    <h6> @Model.UserAddress.PostalCode @Model.UserAddress.City</h6>
                                    <h6 >@Model.UserAddress.PhoneNumber</h6>
                                </div>
                            </label>
                        </div>

                        <div class="col-4 text-start">
                            <h6> Ordrebekreftelse sendes til @Model.UserAddress.AspNetUsers.Email</h6>
                        </div>

                    </div>
                </div>
            </div>
        </li>
    </ul>
</section>

