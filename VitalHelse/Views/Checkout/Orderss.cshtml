@using System.Globalization
@model List<VitalHelse.Models.Order>
@{
    Layout = "_Layout";
    var no = new CultureInfo("nb-NO");
    ViewBag.Title = "Alle ordre";
}

<h2 class="mb-3">Alle ordre</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Ingen ordre funnet.</div>
}
else
{
    <div class="accordion" id="ordersAccordion">
        @for (int i = 0; i < Model.Count; i++)
        {
            var o = Model[i];
            var orderKey = $"order{i}";
            var items = o.OrderProducts?.ToList() ?? new List<VitalHelse.Models.OrderProduct>();
            var total = o.TotalCost; // eller beregn: items.Sum(x => x.UnitPrice * x.Quantity)

            <div class="accordion-item mb-2">
                <h2 class="accordion-header" id="heading-@orderKey">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="#collapse-@orderKey"
                            aria-expanded="false" aria-controls="collapse-@orderKey">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <div>
                                <span class="fw-semibold">Ordre #@o.OrderId</span>
                                <span class="text-muted ms-2">@o.OrderDate</span>
                                <span class="badge bg-secondary ms-3">@o.Status</span>
                            </div>
                            <div class="text-end">
                                <div class="fw-semibold">@total.ToString("C", no)</div>
                                <small class="text-muted">
                                    @(o.AspNetUsers != null ? o.AspNetUsers.Email : "")
                                </small>
                            </div>
                        </div>
                    </button>
                </h2>

                <div id="collapse-@orderKey" class="accordion-collapse collapse"
                     aria-labelledby="heading-@orderKey" data-bs-parent="#ordersAccordion">
                    <div class="accordion-body">

                        <!-- Ordreinfo -->
                        <div class="row g-3">
                            <div class="col-lg-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h6 class="mb-3">Ordreinformasjon</h6>
                                        <div class="d-flex justify-content-between">
                                            <span>Ordre-ID</span><span class="fw-semibold">#@o.OrderId</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Dato</span><span>@o.OrderDate</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Status</span><span>@o.Status</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(o.StripePaymentIntentId))
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>PaymentIntent</span><span class="text-muted">@o.StripePaymentIntentId</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(o.ShippingProvider) || !string.IsNullOrWhiteSpace(o.TrackingNumber))
                                        {
                                            <hr/>
                                            <div class="small text-muted mb-1">Frakt</div>
                                            <div>@o.ShippingProvider @o.TrackingNumber</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(o.DiscountCodeId))
                                        {
                                            <hr/>
                                            <div class="small text-muted mb-1">Rabattkode</div>
                                            <div>@o.DiscountCodeId</div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h6 class="mb-3">Kunde</h6>
                                        @if (o.AspNetUsers != null)
                                        {
                                            <div class="d-flex justify-content-between">
                                                <span>E-post</span><span>@o.AspNetUsers.Email</span>
                                            </div>
                                            <div class="d-flex justify-content-between">
                                                <span>Bruker-ID</span><span class="text-muted">@o.AspNetUsersId</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Ingen brukerinfo.</div>
                                        }

                                        <hr />
                                        <div class="small text-muted mb-1">Leveringsadresse</div>
                                        @if (o.UserAddress != null)
                                        {
                                            <div>@o.UserAddress.FirstName @o.UserAddress.LastName</div>
                                            <div>@o.UserAddress.Street</div>
                                            <div>@o.UserAddress.PostalCode @o.UserAddress.City</div>
                                            <div class="text-muted">Tlf: @o.UserAddress.PhoneNumber</div>
                                        }
                                        else
                                        {
                                            <div class="text-muted">Ingen adresse valgt.</div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Varelinjer -->
                            <div class="col-lg-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h6 class="mb-3">Varelinjer (@items.Count)</h6>
                                        @if (!items.Any())
                                        {
                                            <div class="text-muted">Ingen varelinjer.</div>
                                        }
                                        else
                                        {
                                            <div class="table-responsive">
                                                <table class="table table-sm align-middle">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Produkt</th>
                                                            <th class="text-end">Antall</th>
                                                            <th class="text-end">Enhetspris</th>
                                                            <th class="text-end">Linjetotal</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    @foreach (var line in items)
                                                    {
                                                        var unit = line.UnitPrice;
                                                        var qty = line.Quantity;
                                                        var lineTotal = unit * qty;
                                                        <tr>
                                                            <td>@(line.Product?.ProductName ?? $"#{line.ProductId}")</td>
                                                            <td class="text-end">@qty</td>
                                                            <td class="text-end">@unit.ToString("C", no)</td>
                                                            <td class="text-end">@lineTotal.ToString("C", no)</td>
                                                        </tr>
                                                    }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        <hr />
                                        <div class="d-flex justify-content-between">
                                            <span class="fw-semibold">Total</span>
                                            <span class="fw-semibold">@total.ToString("C", no)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> <!-- /row -->

                    </div>
                </div>
            </div>
        }
    </div>
}
