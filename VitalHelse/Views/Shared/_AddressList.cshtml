@model VitalHelse.Models.UserAddressViewModel

@if (Model.Existing == null || !Model.Existing.Any())
{
    <div class="list-group-item py-4 px-6">
        <div class="text-muted">Ingen lagrede adresser enda.</div>
    </div>
}
else
{
    <!-- Ett skjema som poster valgt adresse -->
    <form asp-action="UseAddress" method="post" class="list-group">
        @Html.AntiForgeryToken()

        @for (var i = 0; i < Model.Existing.Count; i++)
        {
            var a = Model.Existing[i];
            var isChecked =
                Model.SelectedAddressId.HasValue
                    ? Model.SelectedAddressId == a.Id
                    : i == 0; // preselektér første hvis ingenting valgt

            <label class="list-group-item d-flex align-items-start gap-3">
                <input
                    type="radio"
                    class="form-check-input mt-1"
                    name="SelectedAddressId"
                    value="@a.Id"
                    @(isChecked ? "checked" : null) />

                <div class="flex-grow-1">
                    <div class="fw-semibold">@a.FirstName @a.LastName</div>
                    <div>@a.Street</div>
                    <div>@a.PostalCode @a.City</div>
                    <div class="text-muted">Tlf: @a.PhoneNumber</div>
                </div>
            </label>
        }

        <div class="d-grid mt-3">
            <button type="submit" class="btn btn-primary">
                Bruk valgt adresse
            </button>
        </div>
    </form>
}

<script>
document.addEventListener('change', (e) => {
  if (e.target && e.target.name === 'SelectedAddressId') {
    e.target.form.submit();
  }
});
</script>