@model VitalHelse.Models.UserAddressViewModel

    <ul class="list-group">
        @for (var i = 0; i < Model.Existing.Count; i++)
        {
            var userAddress = Model.Existing[i];
            var isChecked = Model.SelectedAddressId == userAddress.Id;

            <li class="list-group-item">
                <div class="row">

                    <div class="col-1 align-content-center">
                        <input type="radio" class="btn-radio" name="SelectedAddressId" value="@userAddress.Id" @(isChecked ? "checked" : null)/>
                    </div>

                    <div class="col-11">
                        <div class="row align-items-center">
                            <div class="col-6">
                                <label class="d-flex text-start py-2">
                                    <div class="flex-grow-1">
                                        <h6>@userAddress.FirstName @userAddress.LastName</h6>
                                        <h6>@userAddress.Street</h6>
                                        <h6>@userAddress.PostalCode @userAddress.City</h6>
                                        <h6>@userAddress.PhoneNumber</h6>
                                    </div>
                                </label>
                            </div>

                            <div class="col-4 text-start">
                                <h6> Ordrebekreftelse sendes til @userAddress.AspNetUsers.Email</h6>
                            </div>

                            <div class="col-2 d-flex justify-content-end">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24"height="24" viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 20h4l10.5-10.5-4-4L4 16v4z"/>
                                    <path d="M14.5 5.5 18 9"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
        }
        
        <li class="list-group-item py-3 px-6">
            Ønsker du å legge til en ny adresse? <a href="#" id="show-form-link">Legg til ny adresse</a>
        </li>
    </ul>
