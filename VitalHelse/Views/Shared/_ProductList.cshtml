@model VitalHelse.Models.DiscountViewModel
@{
    bool isCategoryMode = ViewData["IsCategoryMode"] as bool? ?? false;
}

@if (!isCategoryMode)
{
    <table class="table">
        <thead>
        <tr><th>Produkt</th><th>Pris</th><th>Rabattsats (%)</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var product in Model.Products)
        {
            var discount = Model.Discounts.FirstOrDefault(d => d.ProductId == product.ProductId);
            <tr>
                <td>@product.ProductName</td>
                <td>@product.ProductPriceInVAT.ToString("0.00") kr</td>
                <td>
                    <input type="number" class="discount-input" data-id="@product.ProductId"
                           value="@(discount?.DiscountRate ?? 0)" min="0" max="100" step="0.5" />
                </td>
                <td>
                    <button class="save-discount btn btn-success" data-id="@product.ProductId" data-category="false">Lagre</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <table class="table">
        <thead>
        <tr><th>Kategori</th><th>Rabattsats (%)</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var cat in Model.Categories)
        {
            var discount = Model.Discounts.FirstOrDefault(d => d.CategoryId == cat.CategoryId);
            <tr>
                <td>@cat.CategoryName</td>
                <td>
                    <input type="number" class="discount-input" data-id="@cat.CategoryId"
                           value="@(discount?.DiscountRate ?? 0)" min="0" max="100" step="0.5" />
                </td>
                <td>
                    <button class="save-discount btn btn-success" data-id="@cat.CategoryId" data-category="true">Lagre</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
<script>
document.querySelectorAll('.save-discount').forEach(btn => {
    btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const rate = btn.closest('tr').querySelector('.discount-input').value;
        const isCategory = btn.dataset.category === 'true';
        await fetch('/AdminDiscount/UpdateDiscount', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `id=${id}&rate=${rate}&isCategory=${isCategory}`
        });
        alert("Rabattsats lagret!");
    });
});
</script>
}
