@model IEnumerable<object>
@{
    var columns = ViewData["Columns"] as string[] ?? new string[0];
    var rows = ViewData["Rows"] as IEnumerable<IDictionary<string, string>> ?? new List<IDictionary<string, string>>();
    var showActions = (bool?)ViewData["ShowActions"] ?? false;
}

<div class="listview">
    <div class="listview__container">
        <table class="listview__table">
            <thead>
            <tr>
                @foreach (var col in columns)
                {
                    <th>@col</th>
                }
                @if (showActions)
                {
                    <th></th>
                }
            </tr>
            </thead>

            <tbody>
            @foreach (var row in rows)
            {
                <tr class="listview__row">
                    @foreach (var kv in row)
                    {
                        <td class="@(kv.Key.Contains("Pris") || kv.Key.Contains("Rabatt") ? "listview__td--num" : "")">
                            @kv.Value
                        </td>
                    }

                    @if (showActions)
                    {
                        <td>
                            <button class="listview__btn listview__btn--save"
                                    data-id="@row["Id"]"
                                    data-category="@row["IsCategory"]">
                                Lagre
                            </button>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>