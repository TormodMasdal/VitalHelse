@using VitalHelse.Models
@model object

@{
    var listMode       = (string?)ViewData["ListMode"] ?? "product"; // "product" | "category"
    var isDiscountMode = (bool?)ViewData["IsDiscountMode"] ?? false;
    var isAdminView    = (bool?)ViewData["IsAdminView"] ?? false;

    var products   = listMode == "product"  ? Model as IEnumerable<Product>  : null;
    var categories = listMode == "category" ? Model as IEnumerable<Category> : null;
    var discounts  = ViewData["Discounts"] as IEnumerable<ProductDiscount>;
}

<div class="listview">
    <div class="listview__container">
        <table class="listview__table">
            <thead>
                <tr>
                    @if (listMode == "product")
                    {
                        <th>Produkt</th>
                        <th class="listview__th--num">Pris</th>

                        @if (isDiscountMode)
                        {
                            <th class="listview__th--num">Rabatt (%)</th>
                            <th class="listview__th--num">Ny pris</th>
                        }

                        @if (isAdminView && isDiscountMode)
                        {
                            <th></th>
                        }
                    }
                    else
                    {
                        <th>Kategori</th>

                        @if (isDiscountMode)
                        {
                            <th class="listview__th--num">Rabatt (%)</th>
                        }

                        @if (isAdminView && isDiscountMode)
                        {
                            <th></th>
                        }
                    }
                </tr>
            </thead>

            <tbody>
                @if (listMode == "product" && products != null)
                {
                    foreach (var p in products)
                    {
                        var discount = discounts?.FirstOrDefault(d => d.ProductId == p.ProductId);
                        var rate = discount?.DiscountRate ?? 0;
                        var newPrice = p.ProductPriceInVAT * (1 - rate / 100.0);

                        <tr class="listview__row">
                            <td>@p.ProductName</td>
                            <td class="listview__td--num">@p.ProductPriceInVAT.ToString("0.00") kr</td>

                            @if (isDiscountMode)
                            {
                                <td class="listview__td--num">
                                    <input type="number"
                                           class="listview__input"
                                           value="@rate"
                                           min="0" max="100" step="0.5"
                                           aria-label="Rabatt for @p.ProductName" />
                                </td>
                                <td class="listview__td--num">
                                    <span class="listview__computed">@newPrice.ToString("0.00") kr</span>
                                </td>
                            }

                            @if (isAdminView && isDiscountMode)
                            {
                                <td>
                                    <button class="listview__btn listview__btn--save"
                                            data-id="@p.ProductId"
                                            data-category="false">
                                        Lagre
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
                else if (listMode == "category" && categories != null)
                {
                    foreach (var c in categories)
                    {
                        var discount = discounts?.FirstOrDefault(d => d.CategoryId == c.CategoryId);
                        var rate = discount?.DiscountRate ?? 0;

                        <tr class="listview__row">
                            <td>@c.CategoryName</td>

                            @if (isDiscountMode)
                            {
                                <td class="listview__td--num">
                                    <input type="number"
                                           class="listview__input"
                                           value="@rate"
                                           min="0" max="100" step="0.5"
                                           aria-label="Rabatt for @c.CategoryName" />
                                </td>
                            }

                            @if (isAdminView && isDiscountMode)
                            {
                                <td>
                                    <button class="listview__btn listview__btn--save"
                                            data-id="@c.CategoryId"
                                            data-category="true">
                                        Lagre
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
