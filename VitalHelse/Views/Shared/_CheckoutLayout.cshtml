@using VitalHelse.Models.Enums
@{
    Layout = "_Layout";
    
    // Get the current step from viewbag
    var step = ViewBag.Step is CheckoutStep s ? s : CheckoutStep.Cart;

    string btnText;
    string? nextAction;
    
    // Switch case to determine button text and action depending on the checkout step
    switch (step)
    {
        case CheckoutStep.Cart:
            btnText = "Gå videre til leveringsinfo";
            nextAction = "BeginCheckout";
            break;
        case CheckoutStep.Address:
            btnText = "Gå videre til leveringmetode";
            nextAction = "SelectAddress";
            break;
        case CheckoutStep.Shipping:
            btnText = "Gå videre til betaling";
            nextAction = "ReviewOrder";
            break;
        case CheckoutStep.ReviewOrder:
            btnText = "Fullfør bestilling";
            nextAction = "Complete";
            break;
        case CheckoutStep.Complete:
        default:
            btnText = "";
            nextAction = null;
            break;
    }

    // Disable if Cart is empty
    bool disable = step == CheckoutStep.Cart && (Model is IEnumerable<object> col ? !col.Any() : true);
}


<div id="error-box" style="color:red; font-weight:bold; margin-top:10px;"></div>


<!-- Checkout steps/Mini navbar -->
<ul class="nav checkout-steps border-bottom pb-1">
    <li class="nav-item">
        <!-- Check if the user is on the given step then change the class  -->
        <a class="nav-link @(step == CheckoutStep.Cart ? "active" : "")"
           asp-controller="Checkout" asp-action="Index">Kasse</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.Address ? "active" : "")"
           asp-controller="Checkout" asp-action="Address">Personalia</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.Shipping ? "active" : "")"
           asp-controller="Checkout" asp-action="Shipping">Levering</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.ReviewOrder ? "active" : "")"
           asp-controller="Checkout" asp-action="ReviewOrder">Betaling</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.Complete ? "active" : "")"
           asp-controller="Checkout" asp-action="Complete">Fullført</a>
    </li>
</ul>


<div class="container mt-3">
    <div class="row g-3">
        
        <div class="col-md-8">
            @RenderBody()
        </div>
        
        <!-- Summary -->
        <div class="summary col-md-4 text-white">
            <div class="list-group">
                <div class="list-group-item">
                    <h4 class="d-flex justify-content-between fw-semibold mt-1">Sammendrag</h4>
                    <div class="d-flex justify-content-between"><h6>Produkter:</h6><h6 id="sum-products">–</h6></div>
                    <div class="d-flex justify-content-between text-muted"><h6>Produkter før rabatt:</h6><h6 id="sum-before">–</h6></div>
                    <div class="d-flex justify-content-between text-success"><h6>Rabatt på produkter</h6><h6 id="sum-discount">–</h6></div>
                    <div class="d-flex justify-content-between"><h6>Frakt</h6><h6 id="sum-shipping">–</h6></div>
                    <!-- Rabattkode -->
                    <div class="mt-3">
                        <label for="discount-code" class="fw-semibold">Rabattkode</label>
                        <div class="d-flex gap-2">
                            <input type="text" id="discount-code" class="form-control" placeholder="Skriv inn kode" />
                            <button type="button" id="apply-discount" class="btn btn-dark">Bruk</button>
                        </div>
                        <p id="discount-message" class="mt-1" style="font-size:14px;"></p>
                    </div>

                    <hr/>
                    <div class="d-flex justify-content-between fw-semibold"><span>Totalsum</span><span id="sum-total">–</span></div>
                    
                        
                    <div class="d-grid mt-3"> <!-- skal fikse dette rote nede senere når shipping er på plass -->
                        @if (!string.IsNullOrEmpty(btnText) && !string.IsNullOrEmpty(nextAction))
                        {
                            if (disable)
                            {
                                <button class="btn-next w-100 mb-2" disabled aria-disabled="true">@btnText</button>
                            }
                            else
                            {
                                if (step == CheckoutStep.Address)
                                {
                                    <!-- Button for select address form -->
                                    <button type="submit" form="select-address-form" class="btn-next w-100 mb-2">@btnText</button>
                                }
                                else if (step == CheckoutStep.ReviewOrder)
                                {
                                    <form action="/checkout.html" method="GET">
                                        <button type="submit" class="btn-next w-100 mb-2">@btnText</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-controller="Checkout" asp-action="@nextAction">
                                        <button type="submit" class="btn-next w-100 mb-2">@btnText</button>
                                    </form>
                                }
                                
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
        
    </div>
</div>

<script src="~/js/components/shoppingCart.js" asp-append-version="true"></script>

<script>
// Fuction to run the Summary function on load
document.addEventListener('DOMContentLoaded', function () {
    if (typeof Summary === 'function') {
        Summary();
    }
});
</script>

@await RenderSectionAsync("Scripts", required: false)