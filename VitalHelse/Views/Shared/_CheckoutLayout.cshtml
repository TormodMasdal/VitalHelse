@using VitalHelse.Models.Enums
@{
    Layout = "_Layout";
    
    // Gets what checkout step user is on, if checkout is none for some reason then return to Cart
    var step = ViewData["CheckoutStep"] is CheckoutStep s ? s : CheckoutStep.Cart;
}


<div id="error-box" style="color:red; font-weight:bold; margin-top:10px;"></div>


<!-- Checkout steps/Mini navbar -->
<ul class="nav checkout-steps border-bottom pb-1">
    <li class="nav-item">
        <!-- Check if the user is on the given steå then change the class  -->
        <a class="nav-link @(step == CheckoutStep.Cart ? "active" : "")"
           asp-controller="ShoppingCart" asp-action="Index">Kasse</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.Address ? "active" : "")"
           asp-controller="ShoppingCart" asp-action="Address">Personalia</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.Shipping ? "active" : "")"
           asp-controller="ShoppingCart" asp-action="Shipping">Levering</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.Payment ? "active" : "")"
           asp-controller="ShoppingCart" asp-action="Review">Betaling</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(step==CheckoutStep.Complete ? "active" : "")"
           asp-controller="ShoppingCart" asp-action="ShippingInformation">Fullført</a>
    </li>
</ul>


<div class="container mt-3">
    <div class="row g-3">
        
        <div class="col-md-8">
            <div class="card border-1">
                <div class="list-group list-group-flush">
                    @RenderBody()
                </div>
            </div>
        </div>
        
        <!-- Summary -->
        <div class="summary col-md-4 text-white">
            <div class="card">
                <div class="card-body">
                    <h4 class="d-flex justify-content-between fw-semibold">Sammendrag</h4>
                    <div class="d-flex justify-content-between"><h6>Produkter:</h6><h6 id="sum-products">–</h6></div>
                    <div class="d-flex justify-content-between text-muted"><h6>Produkter før rabatt:</h6><h6 id="sum-before">–</h6></div>
                    <div class="d-flex justify-content-between text-success"><h6>Rabatt på produkter</h6><h6 id="sum-discount">–</h6></div>
                    <div class="d-flex justify-content-between"><h6>Frakt</h6><h6 id="sum-shipping">–</h6></div>
                    <hr/>
                    <div class="d-flex justify-content-between fw-semibold"><span>Totalsum</span><span id="sum-total">–</span></div>
                    
                    <div class="d-grid mt-3">
                        <a class="btn-next" href="@Url.Action("Address","ShoppingCart")">Gå videre til leveringsinfo</a>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>

<script src="~/js/components/shoppingCart.js" asp-append-version="true"></script>

<script>
// Fuction to run the Summary function on load
document.addEventListener('DOMContentLoaded', function () {
    if (typeof Summary === 'function') {
        Summary();
    }
});
</script>

@await RenderSectionAsync("Scripts", required: false)