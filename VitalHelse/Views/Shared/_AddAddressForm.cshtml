@model VitalHelse.Models.ShippingInformation

<!-- fjernet class="form-label" fra label  -->

<form asp-action="AddAddress" method="post" class="list-group-item py-4 px-6">
    @Html.AntiForgeryToken()
    <div class="row mb-4">
        <div class="col">
            <div class="floating-border-label">
                <input asp-for="FirstName" type="text" class="form-control" placeholder=""/>
                <label asp-for="FirstName"></label>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="floating-border-label">
                <input asp-for="LastName" type="text" class="form-control" placeholder=""/>
                <label asp-for="LastName" class="form-label"></label>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="floating-border-label">
                <input asp-for="PhoneNumber" type="text" class="form-control" placeholder=""/>
                <label asp-for="PhoneNumber" class="form-label"></label>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <div class="floating-border-label">
                <input asp-for="Street" type="text" class="form-control" placeholder=""/>
                <label asp-for="Street" class="form-label"></label>
                <span asp-validation-for="Street" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="floating-border-label">
                <input asp-for="City" type="text" class="form-control" placeholder=""/>
                <label asp-for="City"></label>
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
        </div>
        <div class="col">
            <div class="floating-border-label">
                <input asp-for="PostalCode" type="text" class="form-control" placeholder=""/>
                <label asp-for="PostalCode" class="form-label"></label>
                <span asp-validation-for="PostalCode" class="text-danger"></span>
            </div>
        </div>
    </div>
        
   
</form>

