@page
@model EmailModel
@{
    ViewData["Title"] = "Endre e-postadresse";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="account-container">
    <div class="account-card">
        <form id="email-form" method="post" class="account-form">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (Model.IsEmailConfirmed)
            {
                <div class="form-group">
                    <label asp-for="Email" class="form-label">E-post</label>
                    <input asp-for="Email" class="form-control" placeholder="Please enter your email." disabled/>
                </div>
            }
            else
            {
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Ny e-post</label>
                    <input asp-for="Email" class="form-control" placeholder="Please enter your email." disabled/>
                    <button id="updateEmail" type="submit" asp-page-handler="SendVerificationEmail" class="btn-submit">Send verification email</button>
                </div>
            }
            <div class="form-group">
                <label asp-for="Input.NewEmail" class="form-label"></label>
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Please enter new email."/>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
            
            <button id="updateEmail" type="submit" asp-page-handler="ChangeEmail" class="btn-submit">Endre e-postadresse</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
